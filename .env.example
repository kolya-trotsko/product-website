# Local development defaults. Production must override unsafe values.
DJANGO_ENV=local
DEBUG=True
SECRET_KEY=dev-insecure-secret-key-change-me
ALLOWED_HOSTS=127.0.0.1,localhost

# Public site metadata.
SITE_NAME=KS KLIMAT KH
SITE_URL=http://localhost:8000

# Database: local SQLite by default. Production should use PostgreSQL.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Required in production when rate limiting is enabled.
REDIS_URL=
RATE_LIMITING_ENABLED=True
TRUST_PROXY_HEADERS=False
USE_X_FORWARDED_FOR=False

# Email.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@localhost

# Google OAuth. Do not commit real client secrets.
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=
GOOGLE_OAUTH2_CLIENT_SECRET_FILE=secrets/google_oauth_client.json

# Telegram. Delivery is queued in the database and sent by process_notification_outbox.
TELEGRAM_NOTIFICATIONS_ENABLED=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_MAX_BYTES=65536

# Production security switches.
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER_ENABLED=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
WHITENOISE_MANIFEST_STRICT=True
DJANGO_LOG_LEVEL=INFO
